# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (Async PostgreSQL with psycopg3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/internships

# Crawler Configuration & Provenance
CRAWLER_USER_AGENT=InternshipIntelBot/1.0 (+https://github.com/internship-intel; contact@example.com)
CRAWLER_REQUEST_TIMEOUT_SECONDS=20.0
CRAWLER_MAX_CONCURRENCY=5

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
